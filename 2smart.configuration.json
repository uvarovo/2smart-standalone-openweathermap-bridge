{
    "title": "Weather Bridge (Open-Meteo)",
    "type": "openweathermap-bridge",
    "registry": "uvarovo/2smart-standalone-openweathermap-bridge",
    "configuration": {
        "fields": [
            {
                "name": "DEVICE_NAME",
                "type": "string",
                "label": "Device name",
                "default": "OpenWeatherMap Bridge",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "OPENWEATHERMAP_APP_ID",
                "type": "string",
                "label": "OpenWeatherMap API key (deprecated, leave empty)",
                "default": "",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "DEBUG",
                "type": "string",
                "label": "Debug",
                "default": null
            }
        ],
        "volumes": {
            "{BRIDGE}/openweathermap": "/etc/openweathermap"
        }
    },
    "icon": "favicon.svg"
}