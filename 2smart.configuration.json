{
    "title": "Weather Bridge (Open-Meteo)",
    "type": "openweathermap-bridge",
    "registry": "uvarovo/2smart-standalone-openweathermap-bridge",
    "configuration": {
        "fields": [
            {
                "name": "DEVICE_NAME",
                "type": "string",
                "label": "Device name",
                "default": "Weather Bridge",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "CITY",
                "type": "string",
                "label": "City (e.g. Moscow)",
                "default": "Moscow",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "COORDINATES",
                "type": "string",
                "label": "Coordinates \"lat, lon\" (optional, overrides city)",
                "default": "",
                "validation": [
                    "string"
                ]
            },
            {
                "name": "DEBUG",
                "type": "string",
                "label": "Debug",
                "default": null
            }
        ],
        "volumes": {
            "{BRIDGE}/openweathermap": "/etc/openweathermap"
        }
    },
    "icon": "favicon.svg"
}
